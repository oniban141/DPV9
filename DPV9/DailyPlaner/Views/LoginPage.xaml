<Page x:Class="DailyPlaner.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DailyPlaner"
      Title="Окно входа" Width="300">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DailyPlanerV8" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Имя пользователя" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <TextBox x:Name="UsernameBox"/>
            </Grid>
            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <PasswordBox x:Name="PasswordBox"/>
            </Grid>
            <Button Content="Войти" Margin="0,0,0,12" Click="Login_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Нет аккаунта?" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Зарегистрироваться" Click="Registration_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
