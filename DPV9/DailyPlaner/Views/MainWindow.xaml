<Window x:Class="DailyPlaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DailyPlaner"
        Title="Ежедневник" Height="768" Width="1280" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="8" MinWidth="230">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ежедневник" FontWeight="Bold" FontSize="14" Margin="4,0,0,10"/>
            <Calendar Grid.Row="1" x:Name="MainCalendar" Margin="4,0,0,10" SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,0,0">
                <TextBlock Text="Выбор:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ItemTypeComboBox" Width="150">
                    <ComboBoxItem Content="Задача"/>
                    <ComboBoxItem Content="Событие"/>
                    <ComboBoxItem Content="Заметка"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,6,0,0">
                <TextBlock Text="Действие:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ActionComboBox" Width="130">
                    <ComboBoxItem Content="Добавить"/>
                    <ComboBoxItem Content="Изменить"/>
                    <ComboBoxItem Content="Удалить"/>
                    <ComboBoxItem Content="Отметить выполненной"/>
                </ComboBox>
            </StackPanel>
            <Button Grid.Row="4" Content="Применить" HorizontalAlignment="Left" Padding="8,2" Margin="4,8,0,0" Click="ApplyButton_Click"/>
            <StackPanel Grid.Row="6" Margin="4">
                <Button Content="Проверить напоминания" Margin="0,0,0,4" Click="CheckRemindersButton_Click"/>
                <CheckBox x:Name="AutoStartCheckBox" Content="Автозапуск" Margin="2,0,0,4" Checked="AutoStartCheckBox_Checked" Unchecked="AutoStartCheckBox_Unchecked"/>
                <Button Content="Выйти" Click="ExitButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Привет, " FontWeight="Bold"/>
                <TextBlock x:Name="HelloUsernameText" Text="" FontWeight="Bold"/>
                <TextBlock Text="!" FontWeight="Bold"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <TextBlock x:Name="SelectedDateText" Text="" FontWeight="Bold" FontSize="14"/>
                <TextBox x:Name="SearchBox" Text="Поиск" HorizontalAlignment="Right" Width="250" TextChanged="SearchBox_TextChanged"/>
            </Grid>
            <ListView Grid.Row="2" x:Name="DayItemsList" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DayItemsList_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4" ToolTip="{Binding Title}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                <TextBlock Text="{Binding KindLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
